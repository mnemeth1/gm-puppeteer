{
  "name": "gm-puppeteer",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server giving an AI assistant full Foundry VTT v14 GM control via a headless Puppeteer-managed Chromium",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gm-puppeteer": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "start": "node dist/index.js",
    "debug:login": "npm run build && node scripts/debug-login.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pino": "^9.5.0",
    "puppeteer": "^24.15.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
