# GM-Puppeteer environment configuration
#
# This file documents every supported variable. The server reads its
# config from the process environment (`process.env`) — set these in the
# launching client's `env` block, or copy this file to `.env` and launch
# Node with `--env-file=.env` (Node loads `.env` only when told to; there
# is no automatic discovery). See README.md. .env is gitignored.

# Foundry VTT server URL (the headless Chromium will navigate here)
FOUNDRY_URL=http://localhost:30001

# GM user the headless Chromium logs in as.
# Must exist on the active world with Gamemaster role.
FOUNDRY_GM_USERNAME=AI-GM
FOUNDRY_GM_PASSWORD=

# Puppeteer: run headless (true) or with a visible window (false).
# Visible is useful for diagnosing login issues during development; the
# production deployment stays headless.
FOUNDRY_HEADLESS=true

# How long to wait for `game.ready` after submitting the join form (ms).
# In Forge mode this also bounds the headless restore: how long to poll
# for the Foundry screen to settle while the world boots. Forge-hosted
# worlds can take 20-40 s to load — raise this if a heavy world is slower.
FOUNDRY_LOGIN_TIMEOUT_MS=60000

# --- Forge-hosted Foundry (forge-vtt.com) ---------------------------------
#
# A Forge-hosted world sits behind a Forge account login (OAuth / 2FA /
# CAPTCHA) that cannot be scripted. Set FORGE_MODE=true to enable a
# persisted-session flow:
#
#   * First run (no saved session): a VISIBLE Chromium window opens — log
#     in to Forge by hand. The browser profile is saved on close, and the
#     server then relaunches headless to do its work.
#   * Later runs: the saved session is restored headlessly; no window.
#   * If the saved session has expired, the visible login repeats.
#
# Leave FORGE_MODE unset (or false) for local/LAN Foundry — the original
# scripted-login flow is used and nothing below applies.
FORGE_MODE=false

# Directory where the Chromium profile (cookies / localStorage) for the
# Forge session is persisted. An absolute path is recommended — a relative
# path is resolved against the server's working directory, which the MCP
# client controls. This directory holds live session tokens: treat it like
# a credential, keep it gitignored, and restrict its file permissions.
# Default lives at <cwd>/.puppeteer-profile (already gitignored).
FORGE_PROFILE_DIR=.puppeteer-profile

# How long (ms) to wait for a human to finish the visible Forge login
# before giving up. The 60 s join timeout above is too short for 2FA.
FORGE_MANUAL_LOGIN_TIMEOUT_MS=300000

# Note: in Forge mode, FOUNDRY_HEADLESS controls only the restored/working
# session — the first-time login is always visible regardless of its value.

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Pre-warm Foundry's internal compendium cache at session start.
#
# Phase 1 (always runs when this is true): parallel widened pack.getIndex
# over every Actor + Item pack. Wall clock ≈ the slowest pack
# (~25-30 s on a large content world; ~5-10 s on lighter worlds).
# Memory cost is small (~10 MB) — Foundry caches the projected index.
#
# Phase 2: for each pack in WARM_PHASE2_PACKS, chunked pack.getDocument
# over every entry so the first descriptionMatch query against those
# packs is instant. Cost per pack ≈ entries * ~90 ms (chunk size 16,
# Foundry serializes server-side) and ~120-240 KB memory per doc.
#
# Both phases run in the background after the Foundry tab is ready —
# the user's first tool call is not blocked.
WARM_COMPENDIUM_ON_START=true

# Register the `foundry_eval` tool, which runs arbitrary JavaScript
# against the live Foundry GM client.
#
# `foundry_eval` is the deliberate escape hatch for probing v14 APIs,
# diagnosing state, and covering capability gaps — invaluable during
# development. It is also a real risk on a shared/published server:
# arbitrary Foundry-side content (a journal entry, a chat message) that
# reaches a connected LLM could in principle drive it.
#
# Defaults to false: the tool is NOT registered and is invisible to the
# connecting client. Set to true for development; leave false (or unset)
# for any deployment others connect to.
ALLOW_EVAL=false

# Comma-separated compendium-pack IDs to fully warm (phase 2).
# Empty string skips phase 2 entirely (first descriptionMatch query
# pays the cold-doc cost per pack, ~90 ms/doc, but Foundry then caches
# transparently so subsequent matches over the same pack are fast).
#
# Default warms the canonical Remastered creatures pack only. Add
# pf2e.pathfinder-bestiary, pf2e.pathfinder-bestiary-2, etc. to taste —
# expect ~15-45 s additional startup time and ~20-100 MB additional
# memory per medium pack.
WARM_PHASE2_PACKS=pf2e.pathfinder-monster-core
