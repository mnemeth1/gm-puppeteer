# Reference shape of the .env file the installer writes to the install
# directory. The installer generates the real file from the wizard input
# (see installer/scripts/envpage.pas → WriteEnvFile); this template only
# documents the keys and is not consumed at install time.
#
# Placeholders in <angle brackets> are filled from wizard controls.
# The two PUPPETEER_* lines are appended automatically and point at the
# bundled Chromium — do not remove them.

FOUNDRY_URL=<wizard: Foundry server URL>
FOUNDRY_GM_USERNAME=<wizard: GM username>
FOUNDRY_GM_PASSWORD=<wizard: GM password>
FOUNDRY_HEADLESS=<wizard: Run Chromium headless>
FOUNDRY_LOGIN_TIMEOUT_MS=<wizard: Login timeout>
LOG_LEVEL=<wizard: Log level>
WARM_COMPENDIUM_ON_START=<wizard: Pre-warm compendium cache>
ALLOW_EVAL=<wizard: Enable foundry_eval>
FORGE_MODE=<wizard: Forge-hosted world>
FORGE_PROFILE_DIR=<wizard: Forge profile directory>
FORGE_MANUAL_LOGIN_TIMEOUT_MS=<wizard: Forge manual login timeout>
PUPPETEER_EXECUTABLE_PATH=<installdir>\chromium\chrome.exe
PUPPETEER_CACHE_DIR=<installdir>\chromium

# Optional, not written by the wizard. The compendium warm auto-selects
# packs by document-type priority and a document budget; add these to tune
# it: WARM_DOC_BUDGET (integer, default 1500) or WARM_PHASE2_PACKS (comma-
# separated pack ids that override auto selection).
